# All credentials remain on this local server. Do not put them in public/.
PORT=4173
TAROT_PROVIDER=local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
# Default: Qwen 3.5 readings / follow-ups use 12288 with reasoning enabled.
# Other local models use 8192 for 1–3 cards, 12288 for 5 cards / follow-ups.
# Uncomment to override for your hardware (4096–16384).
# OLLAMA_NUM_CTX=12288
# For Qwen, use the endpoint in the same region as your API key.
QWEN_MODEL=qwen3.8-flash
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_API_KEY=
